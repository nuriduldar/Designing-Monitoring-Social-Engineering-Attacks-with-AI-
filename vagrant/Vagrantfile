# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|
  # Use Ubuntu Jammy (22.04)
  config.vm.box = "ubuntu/jammy64"
  
  # VM name
  config.vm.hostname = "social-engineering-ai"
  
  # Network configuration
  config.vm.network "forwarded_port", guest: 5000, host: 5000  # Flask app
  config.vm.network "forwarded_port", guest: 8025, host: 8025  # MailHog UI
  config.vm.network "forwarded_port", guest: 1025, host: 1025  # MailHog SMTP
  
  # Synced folder - project root to /home/vagrant/project
  config.vm.synced_folder ".", "/home/vagrant/project"
  
  # Provider configuration (VirtualBox)
  config.vm.provider "virtualbox" do |vb|
    vb.name = "social-engineering-ai-vm"
    vb.memory = 4096
    vb.cpus = 2
    vb.gui = false
  end
  
  # Provisioning script
  config.vm.provision "shell", path: "vagrant/provision.sh", privileged: false
end

